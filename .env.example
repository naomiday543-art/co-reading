# AI API 配置
AI_BASE_URL=https://api.anthropic.com/v1
AI_API_KEY=sk-xxx
AI_MODEL=claude-sonnet-4-6
AI_FORMAT=anthropic

# 可選：經 research-gateway 的 normalized OpenAI-compatible 介面
# 本機 Gateway: http://127.0.0.1:8788/v1
# 部署後（nginx /research/ strip prefix）: https://your-domain.example/research/v1
# AI_BASE_URL=https://your-domain.example/research/v1
# AI_API_KEY=<PROXY_API_KEY>
# AI_MODEL=<gateway-allow-listed-model>
# AI_FORMAT=openai
# base URL 不要包含 /chat/completions；Coreading 會自動補上。

# 通讀用的模型（可選，默認用上面的）
# ANALYZE_BASE_URL=https://api.deepseek.com/v1
# ANALYZE_API_KEY=sk-xxx
# ANALYZE_MODEL=deepseek-chat
# ANALYZE_FORMAT=openai
# ANALYZE_VISION_MODE=auto  # auto / on / off；OpenCode Go vision-exp 請設 on
# 明確能力宣告（三態，壓過下面的名字猜測）：true / false / 留空
# 留空時退回名字猜測 /claude|vision|gpt-4o|gpt-5|gemini/ —— 那會把 text-only 的
# provider 誤判成看得懂圖。最實際的例子：Antigravity 的 gemini-3.7-flash-low
# 命中 /gemini/ 卻只吃文字，送圖過去會靜默丟失。指向那種線時務必設 false。
#ANALYZE_VISION_CAPABLE=false
# ANALYZE_VISION_MODEL=deepseek-v4-flash-vision-exp  # 可與最終通讀模型分開

# 通讀的串流韌性（工單 10）
# 閒置逾時：兩個 chunk 之間最長可以隔多久。預設 60s；總逾時（AI_REQUEST_TIMEOUT_MS，
# 預設 300s）保留，兩顆疊著用。通讀沒有逐字 UI，沒人會看著它停住，所以停滯要程式自己發現。
# 若正常的長論文被誤殺（日誌出現 `[ANALYZE] ... kind=idle` 但其實模型還在想），調到 120000。
# 0／非數字退回預設；合法區間 [5000, 2147483647]。
#ANALYZE_IDLE_TIMEOUT_MS=60000
# 連線類失敗自動重試幾次（只對停滯／逾時／fetch failed／429/502/503/504 重試；
# 4xx 與「格式不正確」「輸出預算用盡」不重試）。預設 1，區間 [0,3]，0 ＝ 關掉。
#ANALYZE_RETRIES=1

# 送進模型的論文全文上限（工單 13）
# 通讀與討論共用。預設 250000 字 ≈ 65000 token（報告 11 實測 3.85 字/token）。
# 超過就截斷並在結尾附「[全文已截斷]」，`GET /api/papers/:id` 會回 full_text_truncated。
# 出現「論文太長，超過模型窗口」時把這個數字調低；窗口很大的線可以調高。
# 空／非數字退回預設；合法區間 [20000, 2000000]。
#PAPER_FULLTEXT_LIMIT_CHARS=250000
# 參考文獻區塊切除（工單 13 §3.2、工單 16）。預設開：送模型前把每個 References 區塊
# 換成一行「[參考文獻 N 字已略去]」，papers.full_text 原文不動（閱讀模式看到的還是全文）。
# 一篇可能不只一塊（Nature 版式＝主文獻表在 Methods 之前 ＋ Methods 補充文獻表）。
# 懷疑它切錯（例如模型說某段讀不到）時設 false 關掉，並看 `[TEXTMETA]` 日誌
#（`blocks=` 幾塊、`chars_total=` 切掉多少字、`reason=` 沒切的話為什麼）。
#CUT_REFERENCES=true

# 記憶提取（工單 08）
# 輸出預算：推理模型的思考鏈與正文共用同一個 completion 預算，太小會「HTTP 200 但正文空」。
# 錯誤訊息出現「輸出預算用盡」時調高這個數字。
#EXTRACT_MAX_TOKENS=4000
# 落庫前去重的近似閾值（字元 bigram Jaccard，0–1）。預設 0.6：0.6 以上當重複不入庫。
# 調低會開始誤殺「同主題不同陳述」（實測 0.43–0.46 就是那一類），寧可漏殺不誤殺。
#EXTRACT_DEDUP_THRESHOLD=0.6

# 多篇摘要對比（工單 09）
# 輸出預算：對比要吐一張「五維度 × 最多四篇」的表 ＋ 三段分析，比提取長得多。
# 錯誤訊息出現「輸出預算用盡」時調高這個數字。
#COMPARE_MAX_TOKENS=6000

# 服務端口
PORT=3456
