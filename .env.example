# AI API 配置
AI_BASE_URL=https://api.anthropic.com/v1
AI_API_KEY=sk-xxx
AI_MODEL=claude-sonnet-4-6
AI_FORMAT=anthropic

# 可選：經 research-gateway 的 normalized OpenAI-compatible 介面
# 本機 Gateway: http://127.0.0.1:8788/v1
# 部署後（nginx /research/ strip prefix）: https://your-domain.example/research/v1
# AI_BASE_URL=https://your-domain.example/research/v1
# AI_API_KEY=<PROXY_API_KEY>
# AI_MODEL=<gateway-allow-listed-model>
# AI_FORMAT=openai
# base URL 不要包含 /chat/completions；Coreading 會自動補上。

# 通讀用的模型（可選，默認用上面的）
# ANALYZE_BASE_URL=https://api.deepseek.com/v1
# ANALYZE_API_KEY=sk-xxx
# ANALYZE_MODEL=deepseek-chat
# ANALYZE_FORMAT=openai
# ANALYZE_VISION_MODE=auto  # auto / on / off；OpenCode Go vision-exp 請設 on
# 明確能力宣告（三態，壓過下面的名字猜測）：true / false / 留空
# 留空時退回名字猜測 /claude|vision|gpt-4o|gpt-5|gemini/ —— 那會把 text-only 的
# provider 誤判成看得懂圖。最實際的例子：Antigravity 的 gemini-3.7-flash-low
# 命中 /gemini/ 卻只吃文字，送圖過去會靜默丟失。指向那種線時務必設 false。
#ANALYZE_VISION_CAPABLE=false
# ANALYZE_VISION_MODEL=deepseek-v4-flash-vision-exp  # 可與最終通讀模型分開

# 服務端口
PORT=3456
